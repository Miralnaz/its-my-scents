rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Yahan apna Admin UID paste karein (Firebase > Authentication > Users > User UID)
    function isAdmin() { return request.auth != null && request.auth.uid == 'PASTE_ADMIN_UID'; }

    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() < 61
        && request.resource.data.text is string && request.resource.data.text.size() < 401
        && request.resource.data.stars in [3,4,5];
      allow update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow get: if true;            // tracking: unguessable order ID + phone check
      allow list: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.name.size() < 61 && request.resource.data.addr.size() < 201;
      allow update: if isAdmin() || (resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }
  }
}
